@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to StoryBook Teller</h1>
    <p class="lead">A modern web application for creating and sharing interactive stories.</p>
    
    <div class="row mt-5">
        <div class="col-md-4">
            <h3>Create</h3>
            <p>Write your own interactive stories with our easy-to-use editor.</p>
        </div>
        <div class="col-md-4">
            <h3>Share</h3>
            <p>Share your stories with friends, family, or the world.</p>
        </div>
        <div class="col-md-4">
            <h3>Explore</h3>
            <p>Discover stories created by other users in our community.</p>
        </div>
    </div>
    
    <div class="mt-5">
        <p>Built with ASP.NET Core 9.0 - The latest and greatest web framework from Microsoft.</p>
    </div>
</div>