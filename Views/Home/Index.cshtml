@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to StoryBook Teller</h1>
    <p class="lead">A .NET 9 ASP.NET Core web application for creating and sharing interactive stories.</p>
    
    <div class="row mt-5">
        <div class="col-md-4">
            <h3>Create</h3>
            <p>Write your own interactive stories with our easy-to-use editor.</p>
        </div>
        <div class="col-md-4">
            <h3>Share</h3>
            <p>Share your stories with friends and family or publish them to our community.</p>
        </div>
        <div class="col-md-4">
            <h3>Explore</h3>
            <p>Discover and read stories created by other users in our growing library.</p>
        </div>
    </div>
    
    <div class="mt-5">
        <p>This application is built with ASP.NET Core 9, utilizing the MVC pattern for a clean and maintainable codebase.</p>
        <p>Get started by creating your first story today!</p>
    </div>
</div>